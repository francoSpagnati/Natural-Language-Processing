        icd:I12,
        icd:I13,
        icd:I15 ;
    ct:farmaco atc:C03AA ;
    ct:motivo "Diuretico tiazidico o simil-tiazidico come farmaco di prima linea."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-ESH-2024--Guidelines-for-hypertension--trattamento-farmacologico-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C03CA-I50> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I50 ;
    ct:farmaco atc:C03CA ;
    ct:motivo "Diuretico dell'ansa per il controllo della congestione: migliora i sintomi, non la sopravvivenza."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2021--Guidelines-for-heart-failure--trattamento-della-congestione-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C03DA-I50> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I50 ;
    ct:farmaco atc:C03DA ;
    ct:motivo "Antagonista del recettore mineralcorticoide. Terzo pilastro."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2021--Guidelines-for-heart-failure--terapia-dell-HFrEF-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C07AB-I10+I11+I12+I13+I15> a ct:Indicazione ;
    ct:classeRaccomandazione "IIa" ;
    ct:condizione icd:I10,
        icd:I11,
        icd:I12,
        icd:I13,
        icd:I15 ;
    ct:farmaco atc:C07AB ;
    ct:motivo "Betabloccante nell'ipertensione: non di prima linea in assenza di un'indicazione specifica, ma indicato quando coesistono cardiopatia ischemica, scompenso o fibrillazione atriale."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-ESH-2024--Guidelines-for-hypertension--ruolo-dei-betabloccanti-> .

