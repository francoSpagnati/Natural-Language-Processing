    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I21,
        icd:I22,
        icd:I23,
        icd:I25.2 ;
    ct:farmaco atc:C07AB ;
    ct:motivo "Betabloccante dopo infarto miocardico."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Guidelines-for-the-management-of-acute-coronary-syndromes--terapia-a-lungo-termine-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C07AB-I48> a ct:Indicazione ;
