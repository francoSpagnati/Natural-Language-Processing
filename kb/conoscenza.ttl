        icd:I25.2 ;
    ct:farmaco atc:C09AA ;
    ct:motivo "ACE-inibitore dopo infarto miocardico, in particolare con disfunzione ventricolare sinistra."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Guidelines-for-acute-coronary-syndromes--terapia-a-lungo-termine-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C09C-I50> a ct:Indicazione ;
    ct:classeRaccomandazione "IIa" ;
    ct:condizione icd:I50 ;
    ct:farmaco atc:C09C ;
    ct:motivo "Sartano come alternativa all'ACE-inibitore quando questo non e' tollerato, tipicamente per tosse."@it ;
