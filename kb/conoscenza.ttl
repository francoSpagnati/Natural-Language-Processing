    ct:condizione icd:I48 ;
    ct:farmaco atc:C07AB ;
    ct:motivo "Betabloccante per il controllo della frequenza nella fibrillazione atriale."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2024--Guidelines-for-atrial-fibrillation--controllo-della-frequenza-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C07AB-I50> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I50 ;
    ct:farmaco atc:C07AB ;
    ct:motivo "Betabloccante nello scompenso a frazione di eiezione ridotta, in paziente stabile. Secondo pilastro."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2021--Guidelines-for-heart-failure--terapia-dell-HFrEF-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C08CA-I10+I11+I12+I13+I15> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I10,
        icd:I11,
        icd:I12,
        icd:I13,
        icd:I15 ;
    ct:farmaco atc:C08CA ;
    ct:motivo "Calcioantagonista diidropiridinico come farmaco di prima linea, tipicamente in associazione a un bloccante del sistema renina-angiotensina."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-ESH-2024--Guidelines-for-hypertension--trattamento-farmacologico-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C09A-I50> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I50 ;
    ct:farmaco atc:C09A ;
    ct:fattoNonEstratto "frazione di eiezione: nessuna pipeline la estrae, quindi HFrEF e HFpEF non sono distinguibili"@it ;
    ct:motivo "ACE-inibitore nello scompenso a frazione di eiezione ridotta: riduce mortalita' e ricoveri. Primo dei quattro pilastri."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2021--Guidelines-for-the-diagnosis-and-treatment-of-acute-and-chronic-heart-failure--terapia-farmacologica-dell-HFrEF-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C09AA-I10+I11+I12+I13+I15> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I10,
        icd:I11,
        icd:I12,
        icd:I13,
        icd:I15 ;
    ct:farmaco atc:C09AA ;
    ct:motivo "ACE-inibitore come farmaco di prima linea nell'ipertensione."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-ESH-2024--Guidelines-for-the-management-of-elevated-blood-pressure-and-hypertension--strategia-di-trattamento-farmacologico-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C09AA-I21+I22+I23+I25.2> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I21,
        icd:I22,
