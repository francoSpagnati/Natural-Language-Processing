@prefix atc: <https://example.org/terapia-cardiaca/atc/> .
@prefix ct: <https://example.org/terapia-cardiaca/schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icd: <https://example.org/terapia-cardiaca/icd10/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/terapia-cardiaca/kb/controindicazione/A10BA02-N18.4+N18.5> a ct:Controindicazione ;
    ct:condizione icd:N18.4,
        icd:N18.5 ;
    ct:esito "vietato" ;
    ct:farmaco atc:A10BA02 ;
    ct:motivo "Metformina in insufficienza renale grave: rischio di acidosi lattica."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-della-metformina--AIFA-EMA---sezione-4-3--soglia-di-filtrato-glomerulare-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/B01A-I60+I61+I62> a ct:Controindicazione ;
    ct:condizione icd:I60,
        icd:I61,
        icd:I62 ;
    ct:esito "vietato" ;
    ct:farmaco atc:B01A ;
    ct:fattoNonEstratto "storicita' della condizione: ConText la calcola, ma lo schema non ha un campo per registrarla e finisce in una stringa di provenienza"@it ;
    ct:motivo "Antitrombotico in emorragia intracranica: rischio di risanguinamento. Vale per l'emorragia in atto o recente; un'emorragia remota e' una cautela, non un divieto."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-degli-anticoagulanti-orali--AIFA-EMA---sezione-4-3--ESC-2020--Guidelines-for-atrial-fibrillation-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/C01BD01-E05+E03> a ct:Controindicazione ;
    ct:condizione icd:E03,
        icd:E05 ;
    ct:esito "da_verificare" ;
    ct:farmaco atc:C01BD01 ;
    ct:motivo "Amiodarone in tireopatia: il farmaco contiene iodio e altera la funzione tiroidea; richiede monitoraggio o alternativa."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-dell-amiodarone--AIFA-EMA---sezioni-4-3-e-4-4-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/C03A-M10> a ct:Controindicazione ;
    ct:condizione icd:M10 ;
    ct:esito "da_verificare" ;
    ct:farmaco atc:C03A ;
    ct:motivo "Diuretico tiazidico in gotta: riduce l'escrezione di acido urico e puo' precipitare un attacco."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-dei-tiazidici--AIFA-EMA---sezione-4-4-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/C07-I44.1+I44.2+I44.3> a ct:Controindicazione ;
    ct:condizione icd:I44.1,
        icd:I44.2,
        icd:I44.3 ;
    ct:esito "vietato" ;
    ct:farmaco atc:C07 ;
    ct:fattoNonEstratto "presenza di pacemaker o defibrillatore (ICD-10 Z95.0)"@it ;
    ct:motivo "Betabloccante in blocco atrioventricolare di grado avanzato: rischio di bradicardia grave e asistolia. La controindicazione cade se il paziente porta un pacemaker."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/Riassunto-delle-Caratteristiche-del-Prodotto-dei-betabloccanti--AIFA-EMA---sezione-4-3-Controindicazioni-> ;
    ct:revocataDa icd:Z95,
        icd:Z95.0 .

<https://example.org/terapia-cardiaca/kb/controindicazione/C07-J45+J44> a ct:Controindicazione ;
    ct:condizione icd:J44,
        icd:J45 ;
    ct:esito "da_verificare" ;
    ct:farmaco atc:C07 ;
    ct:motivo "Betabloccante in asma o broncopneumopatia: rischio di broncospasmo. I cardioselettivi sono spesso tollerati, quindi la decisione e' clinica."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-ESH-2024--Guidelines-for-the-management-of-elevated-blood-pressure-and-hypertension--sezione-sui-betabloccanti-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/C08D-I50> a ct:Controindicazione ;
    ct:condizione icd:I50 ;
    ct:esito "vietato" ;
    ct:farmaco atc:C08D ;
    ct:motivo "Calcioantagonista non diidropiridinico (verapamil, diltiazem) in scompenso cardiaco a frazione di eiezione ridotta: effetto inotropo negativo."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2021--Guidelines-for-the-diagnosis-and-treatment-of-acute-and-chronic-heart-failure--raccomandazioni-sui-farmaci-da-evitare-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/C09-I70.1> a ct:Controindicazione ;
    ct:condizione icd:I70.1 ;
    ct:esito "vietato" ;
    ct:farmaco atc:C09 ;
    ct:motivo "ACE-inibitore o sartano in stenosi bilaterale delle arterie renali: rischio di insufficienza renale acuta."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-degli-ACE-inibitori--AIFA-EMA---sezione-4-3-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/C09-O00+O09+O10+O11+O12+O13+O14+O15+O16+O20+O21> a ct:Controindicazione ;
    ct:condizione icd:O00,
        icd:O09,
        icd:O10,
        icd:O11,
        icd:O12,
        icd:O13,
        icd:O14,
        icd:O15,
        icd:O16,
        icd:O20,
        icd:O21 ;
    ct:esito "vietato" ;
    ct:farmaco atc:C09 ;
    ct:motivo "ACE-inibitore o sartano in gravidanza: tossicita' fetale documentata nel secondo e terzo trimestre."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-degli-ACE-inibitori-e-dei-sartani--AIFA-EMA---sezione-4-3-e-4-6-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/C10AA-K70+K71+K72+K74> a ct:Controindicazione ;
    ct:condizione icd:K70,
        icd:K71,
        icd:K72,
        icd:K74 ;
    ct:esito "da_verificare" ;
    ct:farmaco atc:C10AA ;
    ct:motivo "Statina in epatopatia attiva: richiede valutazione della funzione epatica prima e durante il trattamento."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-delle-statine--AIFA-EMA---sezione-4-3-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/M01A-I50> a ct:Controindicazione ;
    ct:condizione icd:I50 ;
    ct:esito "vietato" ;
    ct:farmaco atc:M01A ;
    ct:motivo "Antinfiammatorio non steroideo in scompenso cardiaco: ritenzione idrica e peggioramento dello scompenso."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2021--Guidelines-for-heart-failure--farmaci-da-evitare-> .

<https://example.org/terapia-cardiaca/kb/controindicazione/M01A-N18.4+N18.5> a ct:Controindicazione ;
    ct:condizione icd:N18.4,
        icd:N18.5 ;
    ct:esito "vietato" ;
    ct:farmaco atc:M01A ;
    ct:motivo "Antinfiammatorio non steroideo in insufficienza renale cronica avanzata: ulteriore riduzione della filtrazione glomerulare."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/RCP-dei-FANS--AIFA-EMA---sezione-4-3-> .

<https://example.org/terapia-cardiaca/kb/indicazione/A02BC-B01A> a ct:Indicazione ;
    ct:classeRaccomandazione "IIa" ;
    ct:farmaco atc:A02BC ;
    ct:fattoNonEstratto "rischio emorragico gastrointestinale: richiede anamnesi di ulcera, eta' e uso concomitante di FANS"@it ;
    ct:motivo "Inibitore di pompa protonica in paziente in terapia antitrombotica: riduce il rischio di sanguinamento gastrointestinale. La linea guida la raccomanda in classe I nei pazienti ad alto rischio emorragico, che questo sistema non sa identificare."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Guidelines-for-acute-coronary-syndromes--e-ESC-2024--Guidelines-for-atrial-fibrillation--prevenzione-del-sanguinamento-gastrointestinale-> ;
    ct:terapiaRichiesta atc:B01A .

<https://example.org/terapia-cardiaca/kb/indicazione/A10BA-E10+E11+E13+E14> a ct:Indicazione ;
    ct:classeRaccomandazione "IIa" ;
    ct:condizione icd:E10,
        icd:E11,
        icd:E13,
        icd:E14 ;
    ct:farmaco atc:A10BA ;
    ct:motivo "Metformina come terapia di fondo del diabete di tipo 2."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Guidelines-for-cardiovascular-disease-in-patients-with-diabetes--controllo-glicemico-> .

<https://example.org/terapia-cardiaca/kb/indicazione/A10BJ-E10+E11+E13+E14> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:E10,
        icd:E11,
        icd:E13,
        icd:E14 ;
    ct:farmaco atc:A10BJ ;
    ct:motivo "Agonista del recettore del GLP-1 nel diabete di tipo 2 con malattia cardiovascolare accertata."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Guidelines-for-cardiovascular-disease-in-patients-with-diabetes-> .

<https://example.org/terapia-cardiaca/kb/indicazione/A10BK-E10+E11+E13+E14> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:E10,
        icd:E11,
        icd:E13,
        icd:E14 ;
    ct:farmaco atc:A10BK ;
    ct:motivo "Inibitore di SGLT2 nel diabete di tipo 2 con malattia cardiovascolare accertata: beneficio cardiovascolare indipendente dal controllo glicemico."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Guidelines-for-the-management-of-cardiovascular-disease-in-patients-with-diabetes-> .

<https://example.org/terapia-cardiaca/kb/indicazione/A10BK-I50> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I50 ;
    ct:farmaco atc:A10BK ;
    ct:motivo "Inibitore di SGLT2 nello scompenso, indipendentemente dal diabete. Quarto pilastro, aggiunto dall'aggiornamento del 2023."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Focused-update-of-the-2021-heart-failure-guidelines--raccomandazioni-su-dapagliflozin-ed-empagliflozin-> .

<https://example.org/terapia-cardiaca/kb/indicazione/A10BK-N18> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:N18 ;
    ct:farmaco atc:A10BK ;
    ct:motivo "Inibitore di SGLT2 nella malattia renale cronica: rallenta la progressione del danno renale."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2023--Guidelines-for-cardiovascular-disease-in-patients-with-diabetes--sezione-sulla-malattia-renale-cronica-> .

<https://example.org/terapia-cardiaca/kb/indicazione/B01AA-I48> a ct:Indicazione ;
    ct:classeRaccomandazione "IIa" ;
    ct:condizione icd:I48 ;
    ct:farmaco atc:B01AA ;
    ct:motivo "Antagonista della vitamina K quando l'anticoagulante diretto e' controindicato: protesi valvolare meccanica, stenosi mitralica reumatica."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2024--Guidelines-for-atrial-fibrillation--scelta-dell-anticoagulante-> .

<https://example.org/terapia-cardiaca/kb/indicazione/B01AC-I20+I21+I22+I23+I24+I25+I63+I65+I66+I70+I73> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I20,
        icd:I21,
        icd:I22,
        icd:I23,
        icd:I24,
        icd:I25,
        icd:I63,
        icd:I65,
        icd:I66,
        icd:I70,
        icd:I73 ;
    ct:farmaco atc:B01AC ;
    ct:motivo "Antiaggregante piastrinico nella malattia aterosclerotica accertata."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2024--Guidelines-for-the-management-of-chronic-coronary-syndromes--terapia-antitrombotica-> .

<https://example.org/terapia-cardiaca/kb/indicazione/B01AF-I48> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I48 ;
    ct:farmaco atc:B01AF ;
    ct:fattoNonEstratto "punteggio CHA2DS2-VA: richiede eta' e sesso, che lo schema non contiene"@it ;
    ct:motivo "Anticoagulante orale diretto nella fibrillazione atriale: prevenzione del cardioembolismo. Preferito agli antagonisti della vitamina K."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2024--Guidelines-for-the-management-of-atrial-fibrillation--raccomandazioni-sulla-prevenzione-del-tromboembolismo-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C01AA-I48> a ct:Indicazione ;
    ct:classeRaccomandazione "IIa" ;
    ct:condizione icd:I48 ;
    ct:farmaco atc:C01AA ;
    ct:motivo "Digossina per il controllo della frequenza, in aggiunta o quando i betabloccanti non bastano."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2024--Guidelines-for-atrial-fibrillation--controllo-della-frequenza-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C01BD-I48> a ct:Indicazione ;
    ct:classeRaccomandazione "IIa" ;
    ct:condizione icd:I48 ;
    ct:farmaco atc:C01BD ;
    ct:motivo "Amiodarone per il mantenimento del ritmo sinusale nei pazienti in cui si sceglie la strategia di controllo del ritmo."@it ;
    ct:recommendedBy <https://example.org/terapia-cardiaca/kb/linea_guida/ESC-2024--Guidelines-for-atrial-fibrillation--controllo-del-ritmo-> .

<https://example.org/terapia-cardiaca/kb/indicazione/C03AA-I10+I11+I12+I13+I15> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I10,
