<https://example.org/terapia-cardiaca/kb/indicazione/C09CA-I10+I11+I12+I13+I15> a ct:Indicazione ;
    ct:classeRaccomandazione "I" ;
    ct:condizione icd:I10,
        icd:I11,
        icd:I12,
